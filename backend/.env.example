# Copy to .env (gitignored) and fill in real values — NEVER commit this file
# with real credentials. In production these are set as environment
# variables on the host/orchestrator (e.g. docker-compose's env_file, a
# secrets manager, systemd EnvironmentFile) — never baked into the Docker
# image, never logged, never exposed in any API response.

# --- SMTP (outbound mail only — no IMAP) ---
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
# true for port 465 (implicit TLS), false for port 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=booking@virtual-marketer.de
SMTP_PASS=
SMTP_FROM="Virtual Marketer <booking@virtual-marketer.de>"

# Internal address that receives every booking/contact notification
NOTIFY_TO=info@virtual-marketer.de

# --- Server ---
PORT=4000
# Absolute path to the SQLite database file. In Docker this should point
# into a mounted volume so data survives container recreation.
DB_PATH=/data/virtual-marketer.sqlite3
# Public site origin, used to build links in outgoing emails
# (confirmation links, etc.)
PUBLIC_BASE_URL=https://virtual-marketer.de

# --- Booking rules ---
# Business hours are hardcoded to Mon-Fri, Europe/Berlin, in src/slots.js —
# only the window bounds and slot length are configurable here.
BOOKING_TZ=Europe/Berlin
BOOKING_START_HOUR=14
BOOKING_END_HOUR=20
BOOKING_SLOT_MINUTES=30
CONFIRM_TOKEN_TTL_HOURS=48
